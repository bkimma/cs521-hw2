// dp2.cf : DeepPoly refined with interval (box) analysis  -- "DeepPoly x Interval".
//
// What is new compared to deeppoly.cf
// -----------------------------------
// DeepPoly computes each neuron's concrete bounds l,u purely by polyhedral
// back-substitution of the affine expression down to the input layer. That is
// relational and usually tight, but on a crossing-ReLU network the repeated
// triangle relaxations can occasionally make a back-substituted bound LOOSER
// than a single interval (box) step taken from the already-tight concrete
// bounds of the immediately previous layer.
//
// dp2 runs BOTH at every Affine layer and keeps the better one:
//     l = max( interval_lower , backsubstituted_lower )
//     u = min( interval_upper , backsubstituted_upper )
// The interval bound is the one-step evaluation (.map) of the affine expression
// against prev[l],prev[u]; the back-substituted bound is DeepPoly's. Taking the
// max/min of two sound lower/upper bounds is sound, and because one of the two
// is exactly DeepPoly's, dp2 is NEVER less precise than DeepPoly. It stays in
// the same (l,u,L,U) shape, so provesound and run_cf.py need no new members.

def Shape as (Float l, Float u, PolyExp L, PolyExp U){[(curr[l]<=curr),(curr[u]>=curr),(curr[L]<=curr),(curr[U]>=curr)]};

func simplify_lower(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[l]) : (coeff * n[u]);
func simplify_upper(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[u]) : (coeff * n[l]);

func replace_lower(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[L]) : (coeff * n[U]);
func replace_upper(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[U]) : (coeff * n[L]);

func priority(Neuron n) = n[layer];
func priority2(Neuron n, Float c) = -n[layer];
func stop(Neuron n) = false;
func stop_traverse(Neuron n, Float c) = false;

func backsubs_lower(PolyExp e, Neuron n) = (e.traverse(backward, priority2, stop_traverse, replace_lower){e <= n}).map(simplify_lower);
func backsubs_upper(PolyExp e, Neuron n) = (e.traverse(backward, priority2, stop_traverse, replace_upper){e >= n}).map(simplify_upper);

func relu(Float x) = x >= 0.0 ? x : 0.0;
func relu_lower(Neuron n) = n[l] + n[u] >= 0.0 ? n : 0.0;
func relu_upper(Neuron n) = n[l] >= 0.0 ? n : (n[u] <= 0.0 ? 0.0 : (((n[u]) / ((n[u]) - (n[l]))) * n) - (((n[u]) * (n[l])) / ((n[u]) - (n[l]))));

transformer dp2{
    Affine -> (max((prev.dot(curr[weight]) + curr[bias]).map(simplify_lower),
                   backsubs_lower(prev.dot(curr[weight]) + curr[bias], curr)),
               min((prev.dot(curr[weight]) + curr[bias]).map(simplify_upper),
                   backsubs_upper(prev.dot(curr[weight]) + curr[bias], curr)),
               prev.dot(curr[weight]) + curr[bias],
               prev.dot(curr[weight]) + curr[bias]);
    Relu -> (relu(prev[l]), relu(prev[u]), relu_lower(prev), relu_upper(prev));
}

flow(forward, priority, stop, dp2);
